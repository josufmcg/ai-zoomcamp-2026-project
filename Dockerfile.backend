# EFINGES backend image (backlog task 3).
#
# Builds the FastAPI application with uv and runs it with uvicorn. The build
# context is the repository root so the image can copy `backend/` directly.

FROM python:3.12-slim

# Install uv from the official image; it is used to resolve and run the app.
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/

WORKDIR /app

# Install dependencies first so Docker can cache this layer across code edits.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

# Copy the application source and the Alembic migration setup.
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Apply the migrations, then start the API. The database is reachable because
# the compose service waits for the postgres health check first.
CMD ["sh", "-c", "uv run --no-sync alembic upgrade head && exec uv run --no-sync uvicorn app.main:app --host 0.0.0.0 --port 8000"]
