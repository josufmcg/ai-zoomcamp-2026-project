# EFINGES local stack configuration (backlog task 3).
#
# Copy to `.env` to override any of these values for `docker compose` and the
# root Makefile. Every variable has a safe default, so `.env` is optional.

# Host ports published on 127.0.0.1.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5433

# Browser-facing backend URL baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:8000

# Secret used to sign JWTs. Replace with a strong random value outside local
# development.
SECRET_KEY=dev-only-secret-key-change-me

# Docker Compose network subnet.
EFINGES_SUBNET=10.215.25.0/24

# Image tag applied to the backend and frontend images.
EFINGES_TAG=local
