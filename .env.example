# EFINGES local stack configuration (backlog tasks 3 and 4).
#
# Copy to `.env` to override any of these values for `docker compose` and the
# root Makefile. Every variable has a safe default, so `.env` is optional.

# Frontend and backend host ports are published on all network interfaces.
# PostgreSQL remains bound to 127.0.0.1.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# Observability host ports (backlog task 4).
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200

# Grafana admin credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Browser-facing backend URL baked into the frontend bundle at build time.
# For remote access, set this to the hostname or IP clients use for this host.
VITE_API_URL=http://localhost:8000

# Browser origins allowed to call the backend (backlog task 14). The API must
# echo the frontend origin or the browser blocks every response. Comma-separated.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret used to sign JWTs. Replace with a strong random value outside local
# development.
SECRET_KEY=dev-only-secret-key-change-me-in-production

# Docker Compose network subnet.
EFINGES_SUBNET=10.215.25.0/24

# Image tag applied to the backend and frontend images.
EFINGES_TAG=local
